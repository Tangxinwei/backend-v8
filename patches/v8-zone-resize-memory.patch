diff --git a/src/compiler/turboshaft/phase.cc b/src/compiler/turboshaft/phase.cc
index 0a730b6..aff4714 100644
--- a/src/compiler/turboshaft/phase.cc
+++ b/src/compiler/turboshaft/phase.cc
@@ -16,6 +16,41 @@
 
 namespace v8::internal::compiler::turboshaft {
 
+// [Arashi] ReplaceGraphZone: after CopyingPhase wrote all live data into a
+// companion graph (in new_zone) and SwapWithCompanion transferred internal
+// pointers, we create a proper new Graph in the new zone, swap data from the
+// old graph object, then destroy the old zone to reclaim dead memory.
+void PipelineData::ReplaceGraphZone(
+    ZoneWithName<kGraphZoneName> new_zone) {
+  DCHECK(graph_component_.has_value());
+
+  Graph* old_graph = graph_component_->graph;
+
+  // Clear companion — it holds stale data superseded by SwapWithCompanion.
+  old_graph->clear_companion();
+
+  Zone* nz = new_zone.get();
+
+  // Create a new Graph shell; SwapContentsWith will overwrite its buffers.
+  Graph* new_graph = nz->New<Graph>(nz, 16);
+
+  // Transfer all data from old_graph (whose pointers now reference new zone)
+  // into new_graph (which lives in new zone and will outlive old zone).
+  new_graph->SwapContentsWith(*old_graph);
+
+  bool had_special_rpo = graph_component_->graph_has_special_rpo;
+
+  // Destroy old graph_component_ (releases old zone = reclaims dead memory).
+  graph_component_.reset();
+  graph_component_.emplace(std::move(new_zone));
+
+  // Install the new graph.
+  graph_component_->graph = GraphComponent::Pointer<Graph>(new_graph);
+  graph_component_->source_positions = nullptr;
+  graph_component_->node_origins = nullptr;
+  graph_component_->graph_has_special_rpo = had_special_rpo;
+}
