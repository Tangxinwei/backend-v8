+  Graph& GetOrCreateCompanion(Zone* companion_zone = nullptr) {
     if (!companion_) {
-      companion_ = graph_zone_->New<Graph>(graph_zone_, operations_.size());
+      Zone* zone = companion_zone ? companion_zone : graph_zone_;
+      companion_ = zone->New<Graph>(zone, operations_.size());
 #ifdef DEBUG
       companion_->generation_ = generation_ + 1;
       if (IsCreatedFromTurbofan()) companion_->SetCreatedFromTurbofan();
@@ -1037,10 +1053,123 @@ class Graph {
