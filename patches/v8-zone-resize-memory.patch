     data()->InitializeCodegenComponent(osr_helper, jump_optimization_info);
     if (!SelectInstructions(linkage)) {
       return MaybeHandle<Code>{};
     }
     AllocateRegisters(linkage->GetIncomingDescriptor());
-    // Generate the final machine code.
     AssembleCode(linkage);
   }
 
+  // [Arashi] Release graph early — after AssembleCode the Turboshaft graph is
+  // fully consumed. Freeing it before FinalizeCode reclaims significant memory
+  // (graph_zone holds accumulated dead arena from CopyingPhase Grow ops).
+  if (data()->has_graph()) {
+    data()->ClearGraphComponent();
+  }
+
   return FinalizeCode();
 }
 
