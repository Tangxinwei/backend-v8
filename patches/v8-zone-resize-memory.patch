 namespace v8::internal::compiler::turboshaft {
 
+void GraphZoneCompactionPhase::Run(PipelineData* data, Zone* temp_zone) {
+  // Skip when tracing — node_origins lives in old zone; destroying it would
+  // leave the PhaseScope pointer dangling.
+  if (data->node_origins() != nullptr) {
+    return;
+  }
+
+  // Step 1: Fresh zone — companion graph will be created here.
+  ZoneWithName<kGraphZoneName> new_zone(data->zone_stats(), kGraphZoneName);
+  Zone* nz = new_zone.get();
+
+  // Clear existing companion (left over from prior CopyingPhases).
+  // Without this, GetOrCreateCompanion(nz) would return the OLD companion
+  // (in old zone), and after ReplaceGraphZone the Block pointers dangle.
+  data->graph().clear_companion();
+
+  // Step 2: Copy live graph data into new zone via companion_zone parameter.
+  CopyingPhase<GraphZoneCompactionReducer>::Run(data, temp_zone, nz);
+
+  // Step 3: Replace graph zone — destroys old zone, installs compact new one.
+  data->ReplaceGraphZone(std::move(new_zone));
+}
