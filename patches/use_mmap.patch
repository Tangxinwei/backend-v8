 namespace v8 {
+
+//@billbbzhang, Define A FileMMap Allocator which will be defined in the CreateParams
+class V8_EXPORT FileMmapAllocator {
+ public:
+  virtual ~FileMmapAllocator() {}
+  virtual void* Allocate(size_t size, size_t alignment) = 0;
+  virtual bool Free(void* address, size_t length) = 0;
+  virtual bool IsInVmRegion(void* address) = 0;
+};
+
 namespace base {
 
 class SharedMemory;
 
+
+
 class V8_BASE_EXPORT PageAllocator
     : public NON_EXPORTED_BASE(::v8::PageAllocator) {
  public:
@@ -61,6 +73,103 @@ class V8_BASE_EXPORT PageAllocator
   const size_t commit_page_size_;
 };
 
+class V8_BASE_EXPORT FileMmapPageAllocator : public v8::PageAllocator {
+ public:
+  FileMmapPageAllocator(FileMmapAllocator* fileMmapAllocator);
+  virtual ~FileMmapPageAllocator() {}
+  /**
+   * Gets the page granularity for AllocatePages and FreePages. Addresses and
+   * lengths for those calls should be multiples of AllocatePageSize().
+   */
+  size_t AllocatePageSize() override { return allocate_page_size_; }
+
+  /**
+   * Gets the page granularity for SetPermissions and ReleasePages. Addresses
+   * and lengths for those calls should be multiples of CommitPageSize().
+   */
+  size_t CommitPageSize() override { return commit_page_size_; }
+
+  /**
+   * Sets the random seed so that GetRandomMmapAddr() will generate repeatable
+   * sequences of random mmap addresses.
+   */
+  void SetRandomMmapSeed(int64_t seed) override {}
+
+  /**
+   * Returns a randomized address, suitable for memory allocation under ASLR.
+   * The address will be aligned to AllocatePageSize.
+   */
+  void* GetRandomMmapAddr() override { return nullptr; }
+
+  /**
+   * Allocates memory in range with the given alignment and permission.
+   */
+  void* AllocatePages(void* address, size_t length, size_t alignment,
+                      Permission permissions) override {
+    return file_mmap_allocator_->Allocate(length, alignment);
+  }
+
+  /**
+   * Frees memory in a range that was allocated by a call to AllocatePages.
+   */
+  bool FreePages(void* address, size_t length) override {
+    return file_mmap_allocator_->Free(address, length);
+  }
+
+  /**
+   * Releases memory in a range that was allocated by a call to AllocatePages.
+   */
+  bool ReleasePages(void* address, size_t length, size_t new_length) override {
+    return true;
+  }
+
+  /**
+   * Sets permissions on pages in an allocated range.
+   */
+  bool SetPermissions(void* address, size_t length,
+                      Permission permissions) override {
+    return true;
+  }
+
+  /**
+   * Recommits discarded pages in the given range with given permissions.
+   * Discarded pages must be recommitted with their original permissions
+   * before they are used again.
+   */
+  bool RecommitPages(void* address, size_t length,
+                     Permission permissions) override {
+    return true;
+  }
+
+  /**
+   * Frees memory in the given [address, address + size) range. address and size
+   * should be operating system page-aligned. The next write to this
+   * memory area brings the memory transparently back. This should be treated as
+   * a hint to the OS that the pages are no longer needed. It does not guarantee
+   * that the pages will be discarded immediately or at all.
+   */
+  bool DiscardSystemPages(void* address, size_t size) override { return true; }
+
+  /**
+   * Decommits any wired memory pages in the given range, allowing the OS to
+   * reclaim them, and marks the region as inacessible (kNoAccess). The address
+   * range stays reserved and can be accessed again later by changing its
+   * permissions. However, in that case the memory content is guaranteed to be
+   * zero-initialized again. The memory must have been previously allocated by a
+   * call to AllocatePages. Returns true on success, false otherwise.
+   */
+  virtual bool DecommitPages(void* address, size_t size) override {
+    return true;
+  }
+
+ protected:
+  // FileMMapAllocator Support, must not be null.
+  FileMmapAllocator* file_mmap_allocator_;  
+  const size_t allocate_page_size_;
+  const size_t commit_page_size_;
+};
+
+
 }  // namespace base
 }  // namespace v8
 #endif  // V8_BASE_PAGE_ALLOCATOR_H_
