diff --git a/config/ohos/BUILD.gn b/config/ohos/BUILD.gn
new file mode 100644
index 0000000..0ee05a5
--- /dev/null
+++ b/config/ohos/BUILD.gn
@@ -0,0 +1,77 @@
+import("//build/config/ohos/config.gni")
+assert(is_ohos)
+
+config("compiler") {
+  cflags = [
+    "-ffunction-sections",
+    "-fno-short-enums",
+    "-Wno-sign-conversion",
+    "-Wno-error=sign-conversion",
+  ]
+  defines = [
+    "OSOHOS",
+    "HAVE_SYS_UIO_H",
+  ]
+  if (use_musl) {
+    defines += [
+      "__MUSL__",
+      "_LIBCPP_HAS_MUSL_LIBC",
+      "__BUILD_LINUX_WITH_CLANG",
+    ]
+  }
+  ldflags = [
+    "-Wl,--no-undefined",
+    "-Wl,--exclude-libs=libunwind_llvm.a",
+    "-Wl,--exclude-libs=libc++_static.a",
+  ]
+  if (current_cpu == "arm") {
+    abi_target = "arm-linux-ohosmusl"
+  } else if (current_cpu == "arm64") {
+    abi_target = "aarch64-linux-ohos"
+  } else if (current_cpu == "x64") {
+    abi_target = "x86_64-linux-ohos"
+  } else {
+    assert(false, "Architecture not supported")
+  }
+  cflags += [ "--target=$abi_target" ]
+  ldflags += [ "--target=$abi_target" ]
+  if (use_musl) {
+    include_dirs = [ "$ohos_toolchain_root/include/libcxx-ohos/include/c++/v1" ]
+    include_dirs += [ "$ohos_sysroot/usr/include" ]
+  }
+  asmflags = cflags
+}
+
+config("runtime_library") {
+  libs = []
+  ldflags = []
+  if (use_musl) {
+    defines = [
+      "__MUSL__",
+      "_LIBCPP_HAS_MUSL_LIBC",
+      "__BUILD_LINUX_WITH_CLANG",
+    ]
+    if (current_cpu == "arm64") {
+      ldflags += [ "-Wl,-z,max-page-size=4096" ]
+      ldflags += [ "-Wl,--hash-style=gnu" ]
+      ldflags += [ "-L" + rebase_path("$ohos_sysroot/usr/lib/aarch64-linux-ohos", root_build_dir) ]
+      ldflags += [ "-L" + rebase_path("$ohos_toolchain_root/lib/aarch64-linux-ohos/c++", root_build_dir) ]
+      ldflags += [ "-L" + rebase_path("$ohos_toolchain_root/lib/clang/15.0.4/lib/aarch64-linux-ohos", root_build_dir) ]
+      libclang_rt_file = "$ohos_toolchain_root/lib/clang/15.0.4/lib/aarch64-linux-ohos/libclang_rt.builtins.a"
+    }
+    if (current_cpu == "arm") {
+      ldflags += [ "-L" + rebase_path("$ohos_sysroot/usr/lib/arm-linux-ohos", root_build_dir) ]
+      ldflags += [ "-L" + rebase_path("$ohos_toolchain_root/lib/arm-linux-ohos/c++", root_build_dir) ]
+      libclang_rt_file = "$ohos_toolchain_root/lib/clang/15.0.4/lib/arm-linux-ohos/libclang_rt.builtins.a"
+    }
+    if (current_cpu == "x64") {
+      ldflags += [ "-Wl,-z,max-page-size=4096" ]
+      ldflags += [ "-Wl,--hash-style=gnu" ]
+      ldflags += [ "-L" + rebase_path("$ohos_sysroot/usr/lib/x86_64-linux-ohos", root_build_dir) ]
+      ldflags += [ "-L" + rebase_path("$ohos_toolchain_root/lib/x86_64-linux-ohos/c++", root_build_dir) ]
+      libclang_rt_file = "$ohos_toolchain_root/lib/clang/15.0.4/lib/x86_64-linux-ohos/libclang_rt.builtins.a"
+    }
+    libs += [ rebase_path(libclang_rt_file), "c", "c++", "c++abi" ]
+  }
+  if (current_cpu == "arm") { libs += [ "unwind" ] }
+}
