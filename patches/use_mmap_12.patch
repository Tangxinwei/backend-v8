+FileMmapPageAllocator::FileMmapPageAllocator(
+  FileMmapAllocator* fileMmapAllocator, size_t alignment, void* baseAddress)
+  : file_mmap_allocator_(fileMmapAllocator)
+  , capacity(0)
+  , allocate_page_size_(base::OS::AllocatePageSize())
+  , commit_page_size_(base::OS::CommitPageSize())
+
+{
+  capacity = file_mmap_allocator_->CreateFileMmap(alignment, baseAddress);
+}
+
+/**
+ * Allocates memory in range with the given alignment and permission.
+ */
+void* FileMmapPageAllocator::AllocatePages(void* address, size_t length,
+                                           size_t alignment,
+                                           Permission permissions) {
+  return file_mmap_allocator_->Allocate(length);
+}
+
+/**
+ * Frees memory in a range that was allocated by a call to AllocatePages.
+ */
+bool FileMmapPageAllocator::FreePages(void* address, size_t length) {
+  return file_mmap_allocator_->Free(address, length);
+}
+
+bool FileMmapPageAllocator::IsInVmRegion(void* address) const {
+  return file_mmap_allocator_->IsInVmRegion(address);
+}
