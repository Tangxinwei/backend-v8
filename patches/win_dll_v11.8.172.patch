---
 src/base/contextual.h          | 4 ++++
 src/heap/cppgc/marking-state.h | 2 +-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/base/contextual.h b/src/base/contextual.h
index 3b81c50d115..2798f8affd2 100644
--- a/src/base/contextual.h
+++ b/src/base/contextual.h
@@ -69,7 +69,11 @@ class V8_EXPORT_PRIVATE ContextualVariable {
   static bool HasScope() { return Top() != nullptr; }
 
  private:
+#if defined(V8_OS_WIN) && defined(BUILDING_V8_SHARED)
+  inline static Scope* top_ = nullptr;
+#else
   inline static thread_local Scope* top_ = nullptr;
+#endif
 
 #if defined(USING_V8_SHARED)
   // Hide the access to `top_` from other DLLs/libraries, since access to
diff --git a/src/heap/cppgc/marking-state.h b/src/heap/cppgc/marking-state.h
index 4ce1ce40741..3153407f4f2 100644
--- a/src/heap/cppgc/marking-state.h
+++ b/src/heap/cppgc/marking-state.h
@@ -342,7 +342,7 @@ class MutatorMarkingState final : public BasicMarkingState {
   ~MutatorMarkingState() override = default;
 
   inline bool MarkNoPush(HeapObjectHeader& header) {
-    return MutatorMarkingState::BasicMarkingState::MarkNoPush(header);
+    return BasicMarkingState::MarkNoPush(header);
   }
 
   inline void ReTraceMarkedWeakContainer(cppgc::Visitor&, HeapObjectHeader&);
